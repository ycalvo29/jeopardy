<!DOCTYPE html>
<html>
    <body style="background-color: rgba(0, 29, 161);">
        <textarea="color:white" id ='questionText'><%=question%></textarea>
        <p style="color:white"><h30 id="answer" style="visibility:hidden"> <%=answer%></h30></p>
    </body>
    <script> 
    /*
        let qText = document.getElementById('questionText');
        let codeText = qText.textContent;
        qText.innerHTML = codeText;
        */
        let firstPress = true; 
        window.addEventListener('keydown', function(event) {

        if ((event.key === ' ' || event.code === 'Space')& firstPress){
            console.log('Spacebar was pressed!');
            document.getElementById("answer").style.visibility = "visible";
            event.preventDefault(); 
            firstPress = false;
        } else if (event.key === ' ' || event.code === 'Space'){
            window.location.href= 'http://localhost:4000/';
        }
        });

    </script>
</html> 